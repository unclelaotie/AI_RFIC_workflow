# AI_RFIC_workflow environment template
#
# This file supports both Windows and Linux platforms.
# 
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env (git will ignore it)
# 2. Fill in the paths according to your system
# 3. Source it before running scripts:
#    - Linux/macOS: source .env
#    - Windows (PowerShell): Get-Content .env | ForEach-Object { if ($_ -match '^'s*([^#=]+)=(.*)$') { [Environment]::SetEnvironmentVariable($matches[1], $matches[2]) } }
#    - Or use direnv: install direnv and it will auto-load .env in this directory

# ============================================================================
# ADS INSTALLATION PATHS
# ============================================================================

# ADS Python interpreter path
# Windows example: C:\Keysight\ADS\tools\python\python.exe
# Linux example:   /opt/Keysight/ADS/tools/python/python3
ADS_PYTHON=${ADS_PYTHON:-}

# ADS installation root directory
# Windows example: C:\Keysight\ADS
# Linux example:   /opt/Keysight/ADS
ADS_INSTALL_DIR=${ADS_INSTALL_DIR:-}

# Alternative: HPEEsof directory (older naming convention)
# This is used as fallback if ADS_INSTALL_DIR is not set
# HPEESOF_DIR=${HPEESOF_DIR:-}

# ============================================================================
# PDK CONFIGURATION (Optional)
# ============================================================================

# Main PDK library directory
# Windows example: C:\PDK\pdk_2024
# Linux example:   /home/user/PDK/pdk_2024
PDK_DIR=${PDK_DIR:-}

# Technology/reference library directory paired with the PDK
# Windows example: C:\PDK\pdk_tech_2024
# Linux example:   /home/user/PDK/pdk_tech_2024
PDK_TECH_DIR=${PDK_TECH_DIR:-}

# ============================================================================
# DESIGN PARAMETERS (Optional)
# ============================================================================

# Substrate definition name from the selected PDK/reference library
SUBSTRATE=${SUBSTRATE:-microstrip_substrate}

# ============================================================================
# ML ENVIRONMENT (Optional)
# ============================================================================

# If you maintain a separate Python environment for ML/HDF5/PyTorch,
# you can specify it here for reference by wrapper scripts
# Windows example: C:\Users\YourName\.conda\envs\ml_env\python.exe
# Linux example:   /home/user/miniconda3/envs/ml_env/bin/python3
# ML_PYTHON=${ML_PYTHON:-}

# ============================================================================
# PROJECT PATHS (Optional, usually auto-detected)
# ============================================================================

# Base project directory (where this .env file is located)
# PROJECT_ROOT will be set to the directory containing this file
# PROJECT_ROOT=${PROJECT_ROOT:-$(dirname "$(readlink -f "$0")")} 

# Workspace directory for ADS designs
# WORKSPACE_DIR=${WORKSPACE_DIR:-$PROJECT_ROOT/batch_workspace}

# Output directory for results
# OUTPUT_DIR=${OUTPUT_DIR:-$PROJECT_ROOT/batch_results}

# ============================================================================
# DEBUGGING (Optional)
# ============================================================================

# Enable verbose logging
# DEBUG=${DEBUG:-0}

# Python verbosity level (0-2)
# PYTHONVERBOSITY=${PYTHONVERBOSITY:-0}
